# Minimal bootstrap environment. `python3 scripts/local-setup.py` writes .env from this file
# with fresh random secrets. Only infrastructure/bootstrap values live here: everything an
# operator tunes is managed by admins in the app (Admin → AI, Settings, Integrations) and stored
# in Postgres, so it survives restarts, rebuilds and redeploys:
#   AI providers/keys/models per purpose, daily AI cap, AI input size, sample demo toggle,
#   upload limit, time zone, Personal Coach cadence, Steam Web API key, Stripe keys/switch.

# local | production. "local" enables the development identities below (WEB_TOKEN/DEVICE_TOKEN)
# and the local match simulator; any other value runs in production mode.
APP_ENV=local

# Postgres password. Compose builds DATABASE_URL from it (and from POSTGRES_PORT, default 55432).
POSTGRES_PASSWORD=local-development-only

# Key that encrypts stored credentials (AI provider keys, Steam/Stripe secrets) with AES-256-GCM:
# 32 random bytes, e.g. `openssl rand -base64 32`. Set it once and never change it afterwards
# (stored secrets would have to be re-entered). Empty = derived from WEB_TOKEN (legacy, warns).
APP_ENCRYPTION_KEY=

# Local development session token (browser → API, server-side only). Long random value.
WEB_TOKEN=replace-browser-token
# Token of the local telemetry collector device. Long random value.
DEVICE_TOKEN=replace-device-token
# Shared secret between CS2 Game State Integration, the collector and the simulator.
GSI_AUTH_TOKEN=replace-local-gsi-token
# Account and device ids of the local development identity.
OWNER_ID=dev-owner
DEVICE_ID=dev-device

# Comma-separated SteamID64s that become admin when they sign in with Steam.
ADMIN_STEAM_IDS=

# Optional, machine-specific: host path to an extra CA certificate (PEM) trusted by the API, for
# networks that inspect TLS (corporate proxies). Empty = none.
EXTRA_CA_CERTS_FILE=

# ---------------------------------------------------------------------------------------------
# Optional overrides (defaults shown; uncomment only when needed)
# DEV_AUTO_LOGIN=false          # true signs every visitor in as the dev owner (automated tests only)
# POSTGRES_PORT=55432           # host port of the local Postgres
# API_PUBLIC_URL=http://127.0.0.1:4000
# WEB_ORIGIN=http://127.0.0.1:3000
# ALLOW_DEV_AUTH=false          # disable the development identities even with APP_ENV=local
#
# Running the API on the host instead of Docker (`pnpm dev`) also needs:
# DATABASE_URL=postgres://cs2:local-development-only@127.0.0.1:55432/cs2live
# OBJECT_STORAGE_DIR=.local-data/objects
# DEMO_PARSER_BIN=/tmp/cs2live-demo-parser
#
# Bootstrap-only fallbacks (the admin-managed database value always wins; prefer the app):
# STEAM_WEB_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, APP_TIMEZONE, AI_* (see docs/OPERATIONS.md)
