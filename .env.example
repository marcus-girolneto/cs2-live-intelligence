# Copy to .env and replace these local development credentials.
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
DEVICE_ID=dev-device
OWNER_ID=dev-owner
DEVICE_TOKEN=replace-device-token
WEB_TOKEN=replace-browser-token
GSI_AUTH_TOKEN=replace-local-gsi-token
GSI_LISTEN=127.0.0.1:3002
API_URL=http://127.0.0.1:4000/v1/telemetry/gsi
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:4000
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55432

# Explicit local mode. Omit these flags in any public deployment.
# DEV_AUTO_LOGIN=true skips Steam sign-in (automated tests only). Keep false for real use.
DEV_AUTO_LOGIN=false
APP_ENV=local
ALLOW_DEV_AUTH=true
ENABLE_DEV_AUTH=true
DATABASE_URL=postgres://cs2:local-development-only@127.0.0.1:55432/cs2live
API_PUBLIC_URL=http://127.0.0.1:4000
OBJECT_STORAGE_DIR=.local-data/objects
DEMO_PARSER_BIN=/tmp/cs2live-demo-parser
# ---------------------------------------------------------------------------
# AI coach provider. Any OpenAI-compatible API works; nothing is hardcoded.
# Every AI request in the app performs a real call to this model (no cache,
# no silent fallback). Restart the API after changing these values.
#
# AI_PROVIDER   preset name: openai | openrouter | ollama, or any label
#               (then set AI_BASE_URL)
# AI_BASE_URL   overrides the preset, e.g. https://api.together.xyz/v1
# AI_API_KEY    provider key (not needed for local Ollama)
# AI_MODEL      required, exactly as the provider names it
#
# Examples:
#   OpenAI:      AI_PROVIDER=openai      AI_MODEL=gpt-4.1-mini
#   OpenRouter:  AI_PROVIDER=openrouter  AI_MODEL=qwen/qwen3-235b-a22b-2507
#                (optional) AI_HEADERS={"HTTP-Referer":"http://127.0.0.1:3000","X-Title":"CS2 Live Intelligence"}
#                (optional) AI_EXTRA_BODY={"provider":{"require_parameters":true}}
#   Ollama:      AI_PROVIDER=ollama      AI_MODEL=qwen3:14b
#                AI_BASE_URL=http://host.docker.internal:11434/v1 AI_ALLOW_HTTP=true  (from Docker)
#   Other:       AI_PROVIDER=mycloud AI_BASE_URL=https://.../v1 AI_API_KEY=... AI_MODEL=...
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# chat (/chat/completions, default) | responses (OpenAI /responses)
AI_API_STYLE=
# json_schema (default, strict structured output) | json_object | prompt
# Use json_object or prompt for models without structured-output support.
AI_JSON_MODE=
# Token limit parameter name: max_tokens (default) or max_completion_tokens (OpenAI preset default)
AI_MAX_TOKENS_PARAM=
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_MS=
AI_MAX_ATTEMPTS=
AI_TEMPERATURE=
# JSON objects merged into request headers / body (provider-specific options)
AI_HEADERS=
AI_EXTRA_BODY=
# Global safety cap: AI requests per account per day (all plans, admins included);
# empty or 0 = no cap. Per-plan quotas are edited by admins in the app (Plans).
AI_DAILY_LIMIT=
AI_MAX_INPUT_BYTES=
# Allow plain HTTP to a non-loopback endpoint (e.g. a LAN GPU box)
AI_ALLOW_HTTP=
# Legacy (still honoured when AI_* are empty): OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=

# Steam profile after sign-in. Without a key the API reads the public community profile
# (name, avatar, bio, location, member since, VAC flag, groups, most played games).
# Optional key adds Steam level, CS2 playtime, ban counts, recent games, badges and friends.
# The profile is cached on the account and refreshed at sign-in and every 6 hours.
# Get a key at https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# Administrators manage AI providers/models, credentials and app-wide settings in the app.
# Comma-separated SteamID64s that are made admin when they sign in with Steam:
ADMIN_STEAM_IDS=
# "first-login": while no admin exists, the first account to sign in WITH STEAM becomes admin.
ADMIN_BOOTSTRAP=
# Key for encrypting provider API keys stored in Postgres (AES-256-GCM): 32 random bytes,
# e.g. `openssl rand -base64 32`. If empty, a key is derived from WEB_TOKEN (with a warning);
# changing it later means re-entering stored provider keys.
APP_ENCRYPTION_KEY=

# Optional: extra CA certificate trusted by the API container, for networks that
# inspect TLS (corporate proxies/AI gateways). Path on the host to a PEM file.
EXTRA_CA_CERTS_FILE=

# Plans and quotas. Daily quotas reset at local midnight in this IANA time zone.
APP_TIMEZONE=America/Sao_Paulo

# Billing (optional). Without STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET, billing is disabled
# (GET /v1/billing/status → {enabled:false}) and plans are granted by admins only.
# Webhook endpoint: POST <API_PUBLIC_URL>/v1/billing/webhook with events
# checkout.session.completed, customer.subscription.created/updated/deleted, invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids per plan and interval (a plan's stored stripePrices take precedence).
# Optional currency suffix, e.g. STRIPE_PRICE_BASIC_MONTHLY_BRL; without it the id is used for any currency.
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Payment method types offered at checkout (comma-separated). Pix for subscriptions depends
# on your Stripe account; enable it here only if your account supports it.
STRIPE_PAYMENT_METHODS_BRL=card
STRIPE_PAYMENT_METHODS_USD=card
